# AutoGuard AI environment
# Copy to .env only if you want to override defaults.  Never commit a real key.

# SQLite file (default: data/autoguard.db)
# AUTOGUARD_DB=C:\Users\suraa\Desktop\ANPR2\self-healing-anpr\data\autoguard.db

# Timezone used for "today" and dashboard day boundaries
AUTOGUARD_TZ=Asia/Kolkata

# Set to 0 to disable synthetic demo seeding endpoints
AUTOGUARD_DEMO=1

# Optional hosted model (any OpenAI-compatible chat-completions endpoint)
# AUTOGUARD_LLM_API_KEY=sk-...
# AUTOGUARD_LLM_BASE_URL=https://api.openai.com/v1
# AUTOGUARD_LLM_MODEL=gpt-4o-mini

# Optional local Ollama instead of a hosted key.
# With no variables set, the assistant still auto-connects to
# http://127.0.0.1:11434 within ~15 s when a model is installed.
# AUTOGUARD_OLLAMA_URL=http://127.0.0.1:11434
# AUTOGUARD_OLLAMA_MODEL=llama3.2

# auto = LLM only for technical/explanatory answers; always = rewrite every answer
# AUTOGUARD_LLM_MODE=auto

# Seconds to wait for the model. CPU-only Ollama needs more than a GPU.
# AUTOGUARD_LLM_TIMEOUT=90
